@inherits LayoutComponentBase
@implements IDisposable
@using iPath.Application.Localization
@using iPath.Blazor.Componenents.Notifications
@inject IJSRuntime JS

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudDialogProvider MaxWidth="MaxWidth.Medium"
                   CloseButton="true"
                   BackdropClick="false"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">iPath.NET</MudText>
        <MudSpacer />
        <MudMenu StartIcon="@Icons.Material.Filled.Translate" Label="@locale.ToUpperInvariant()" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            @foreach (var culture in locOpts.Value.SupportedCultures)
            {
                <MudMenuItem OnClick='() => SwitchLanguage(culture)'>
                    @(locOpts.Value.CultureDisplayNames.TryGetValue(culture, out var displayName) ? displayName : culture.ToUpperInvariant())
                </MudMenuItem>
            }
        </MudMenu>
        <MudHidden Breakpoint="Breakpoint.Xs">
            <AuthorizeView>
                <Authorized>
                    <NotificationBell />
                    <IPathAvatar />
                </Authorized>
            </AuthorizeView>
        </MudHidden>
    </MudAppBar>
    <AuthorizeView>
        <Authorized>
            <SseConnectionHost />
        </Authorized>
    </AuthorizeView>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
        <MudSpacer />
        <AboutMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer Class="ipath_main_container">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="errCtx">
                <MudAlert Severity="Severity.Error">
                        <b>@T["Error:"]</b> @errCtx.Message<br />
                        <p>@errCtx.HelpLink</p>
                        <MudButton Variant="Variant.Filled" OnCLick="_ => errorBoundary?.Recover()">
                            @T["try again"]
                        </MudButton>
                </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>

        @if (opts.Value.ShowPageInfo)
        {
            <PageInfo />
        }
    </MudMainContent>
</MudLayout>


@inject ITranslationLoader srvLoc
@inject IOptions<iPathClientConfig> opts
@inject IOptions<LocalizationSettings> locOpts
@inject AppState appState
@inject NavigationManager nm


@code {
    ErrorBoundary errorBoundary;

    bool _drawerOpen = true;
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    string locale => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private void SwitchLanguage(string culture)
    {
        var uri = new Uri(nm.Uri);
        var localPath = uri.LocalPath + uri.Query;
        nm.NavigateTo($"/api/localization/set?culture={culture}&redirectUri={Uri.EscapeDataString(localPath)}", forceLoad: true);
    }

    private bool _isDarkMode = false;
    private MudTheme? _theme = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }


    protected override async Task OnInitializedAsync()
    {
        appState.OnChange += OnAppStateChanged;

        var locale = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        await srvLoc.LoadTranslationData(locale);

        await appState.LoadSessionAsync();
    }

    private void OnAppStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("eval", "document.getElementById('loading-screen')?.remove()");
    }

    async Task Reload()
    {
        await srvLoc.LoadTranslationData(locale, true);
    }

    public void Dispose()
    {
        appState.OnChange -= OnAppStateChanged;
    }


    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(140,180,240,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };

}