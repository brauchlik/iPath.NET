@using System.Text.Json
@using Microsoft.JSInterop

@implements IAsyncDisposable
@implements IQuestionnaireForm
@inject IJSRuntime JS


<div id="@id" class="form"><span>loading ...</span></div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="error">@ErrorMessage</div>
}


@code {
    [Parameter, EditorRequired]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool ShowTitle { get; set; }

    [Parameter]
    public string Questionnaire { get; set; } = "";

    [Parameter]
    public string QuestionnaireResponse { get; set; } = "";


    private string id = $"lhcform_{Guid.NewGuid().ToString("N")}";   


    lhcformsJsInterop interop;
    string ErrorMessage;

    protected override void OnInitialized() 
    {
        interop = new lhcformsJsInterop(JS);
    }

    public async ValueTask DisposeAsync()
    {
        await interop.DisposeAsync();
    }

    // What is currently mounted, so an unrelated re-render does not tear the widget down.
    private string? _loadedQuestionnaire;
    private string? _loadedResponse;
    private bool _rendered;

    protected override async Task OnParametersSetAsync()
    {
        // Before the first render the mount div does not exist yet; OnAfterRenderAsync
        // does the initial load.
        if (_rendered) await LoadFormAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _rendered = true;
            await OnAfterRendered.InvokeAsync();
            await LoadFormAsync();
        }
    }

    public async Task LoadFormAsync()
    {
        if (string.IsNullOrEmpty(Questionnaire)) return;

        // Remounting resets the widget and discards whatever the user has typed, so only
        // do it when the content actually changed.
        if (Questionnaire == _loadedQuestionnaire && QuestionnaireResponse == _loadedResponse) return;

        await LoadFormAsync(Questionnaire, QuestionnaireResponse);
    }


    public async Task LoadFormAsync(string questionnaire, string questionnaireResponse = "")
    {
        try
        {
            ErrorMessage = null;
            await interop.LoadDataAsync(questionnaire, questionnaireResponse, id, ReadOnly);
            _loadedQuestionnaire = questionnaire;
            _loadedResponse = questionnaireResponse;
        }
        catch (Exception ex)
        {
            // Leave the tracking fields unset so a later attempt retries rather than
            // assuming the widget is mounted.
            ErrorMessage = ex.Message;
            StateHasChanged();
        }
    }

    public async Task<string?> GetDataAsync()
    {
        try
        {
            var res = await interop.GetDataAsync(id);
            return res;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        return null;
    }



    [Parameter]
    public EventCallback OnAfterRendered { get; set; }
}