@page "/admin"


<MudBreadcrumbs Items="_items" Class="mt-0 pt-0"></MudBreadcrumbs>

<MudText Typo="Typo.h6" GutterBottom="true">@T["Administration"]</MudText>

<AdminNavMenu />

@code {
    private List<BreadcrumbItem> _items = [];

    protected override void OnInitialized()
    {
        _items =
        [
            new(T["Home"], href: "#"),
            new(T["Administration"], href: null, disabled: true)
        ];
    }
}