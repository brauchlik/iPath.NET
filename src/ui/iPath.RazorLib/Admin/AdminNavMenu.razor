@using iPath.Application.Features.Admin

<AuthorizeView Roles="Admin">
    <Authorized>
        <MudNavGroup Title="Admin" Expanded="true" HeaderClass="mud-theme-info">
            <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.Person">Users</MudNavLink>
            <MudNavLink Href="admin/groups" Icon="@Icons.Material.Filled.Group">Groups</MudNavLink>
            <MudNavLink Href="admin/communities" Icon="@Icons.Material.TwoTone.GroupWork">Communities</MudNavLink>
            <MudNavLink Href="admin/questionnaires" Icon="@Icons.Material.TwoTone.DynamicForm">Questionnaires</MudNavLink>
            <MudNavLink Href="admin/cms" Icon="@Icons.Material.Filled.Pages">News and Pages</MudNavLink>
            <MudNavLink Href="admin/system" Icon="@Icons.Material.Filled.Settings">System</MudNavLink>
            <MudNavLink Href="admin/database" Icon="@Icons.Material.Filled.Storage">
                Database
                @if (pendingCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">@pendingCount.ToString()</MudChip>
                }
            </MudNavLink>
        </MudNavGroup>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Developer">
    <Authorized>
        <MudNavGroup Title="Developers" Expanded="false" HeaderClass="mud-theme-info" Style="border-bottom: 1px solid;">
            <MudNavLink Href="admin/mailbox" Icon="@Icons.Material.Filled.Mail">Mailbox</MudNavLink>
            <MudNavLink Href="admin/email-import" Icon="@Icons.Material.Filled.Email">Email Import</MudNavLink>
            <MudNavLink Href="admin/notifications" Icon="@Icons.Material.Filled.Notifications">Notifications</MudNavLink>
            <MudNavLink Href="admin/events" Icon="@Icons.Material.TwoTone.Event">Event Log</MudNavLink>
            <MudNavLink Href="scalar" Target="_blank" Icon="@Icons.Material.Filled.Api">API</MudNavLink>
        </MudNavGroup>
    </Authorized>
</AuthorizeView>

@inject IPathApi api

@code {
    private int pendingCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resp = await api.GetDatabaseStatus();
            if (resp.IsSuccessful && resp.Content is not null)
            {
                pendingCount = resp.Content.PendingMigrations.Count;
            }
        }
        catch
        {
            // silently ignore
        }
    }
}