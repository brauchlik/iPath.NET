@page "/admin/ai"
@attribute [Authorize(Roles = "Admin")]
@using iPath.Application.Features.Admin
@using iPath.Blazor.Componenents.Admin
@using MudBlazor

<IPathHeader Title="AI Status Dashboard" />

@if (status is null)
{
    <MudText Class="mt-4">Loading AI status...</MudText>
}
else
{
    <MudGrid Class="mt-2">
        <MudItem xs="12" md="6">
            <MudCard Outlined="true" Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">LLM Connection & Configuration</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        @if (status.IsEnabled)
                        {
                            @if (status.IsLlmOnline == true)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">ONLINE</MudChip>
                            }
                            else if (status.IsLlmOnline == false)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">OFFLINE</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">CHECKING...</MudChip>
                            }
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">DISABLED</MudChip>
                        }
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText><b>Global Status:</b> @(status.IsEnabled ? "Enabled" : "Disabled")</MudText>
                    <MudText><b>Active Provider:</b> @status.Provider</MudText>
                    <MudText><b>Chat Model:</b> @(string.IsNullOrEmpty(status.ChatModel) ? "N/A" : status.ChatModel)</MudText>
                    <MudText><b>Embedding Model:</b> @(string.IsNullOrEmpty(status.EmbeddingModel) ? "N/A" : status.EmbeddingModel)</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Outlined="true" Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Background Transcription Queue</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        @if (status.QueueLength > 0)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">PROCESSING</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">IDLE</MudChip>
                        }
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText><b>Queue Strategy:</b> Sequential Single-Reader FIFO</MudText>
                    <MudText><b>Enqueued Cases:</b> @status.QueueLength</MudText>
                    <MudText Class="mud-text-secondary mt-2" Typo="Typo.body2">
                        Protects local GPU / LLM instances from resource exhaustion by processing enqueued transcription tasks one after another.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mt-4 mb-2">Recent Ingestion Activities</MudText>
            @if (status.RecentActivities.Count == 0)
            {
                <MudAlert Severity="Severity.Info">No recent AI activities found in the lineage logs.</MudAlert>
            }
            else
            {
                <MudTable Items="@status.RecentActivities" Dense="true" Striped="true" Hover="true" OnRowClick="@(async (TableRowClickEventArgs<AiActivityDto> args) => await OpenDetailDialogAsync(args))">
                    <HeaderContent>
                        <MudTh>Case Title</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Model Used</MudTh>
                        <MudTh>Outcome</MudTh>
                        <MudTh>Timestamp (UTC)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Case Title">
                            <MudLink Href="@($"/request/{context.CaseId}")" @onclick:stopPropagation="true">@context.CaseTitle</MudLink>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            @if (context.Status == "Completed")
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Completed</MudChip>
                            }
                            else if (context.Status == "Failed")
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                            }
                            else if (context.Status == "Skipped")
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">Skipped</MudChip>
                            }
                            else if (context.Status == "Processing")
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">Processing</MudChip>
                            }
                            else if (context.Status == "Queued")
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">Queued</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small">@context.Status</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Model Used">@context.ModelUsed</MudTd>
                        <MudTd DataLabel="Outcome">
                            @if (context.WasOverridden)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">Overridden by User</MudChip>
                            }
                            else if (context.Status == "Completed")
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Accepted</MudChip>
                            }
                            else if (context.Status == "Failed")
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">Error</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Status</MudChip>
                            }
                            @if (!string.IsNullOrEmpty(context.ErrorMessage))
                            {
                                <MudTooltip Text="@context.ErrorMessage">
                                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" Class="ml-1" />
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Timestamp">@context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudItem>
    </MudGrid>
}

@inject iPath.Blazor.ServiceLib.ApiClient.IPathApi api
@inject IDialogService dialog

@code {
    private AiStatusDto? status;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await api.GetAiStatus(checkConnection: false);
            if (response.IsSuccessful && response.Content is not null)
            {
                status = response.Content;
            }
        }
        catch (Exception ex)
        {
            status = new AiStatusDto
            {
                IsEnabled = false,
                Provider = "Error resolving status",
                IsLlmOnline = false
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && status != null && status.IsEnabled)
        {
            try
            {
                var response = await api.GetAiStatus(checkConnection: true);
                if (response.IsSuccessful && response.Content is not null)
                {
                    status.IsLlmOnline = response.Content.IsLlmOnline;
                }
            }
            catch
            {
                status.IsLlmOnline = false;
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    private async Task OpenDetailDialogAsync(TableRowClickEventArgs<AiActivityDto> args)
    {
        var activity = args.Item;
        if (activity == null) return;
        try
        {
            var response = await api.GetAiLineageDetail(activity.Id);
            AiLineageDetailDto? detail = response.IsSuccessful ? response.Content : null;
            if (detail == null) return;

            var parameters = new DialogParameters<AiLineageDetailDialog>
            {
                { x => x.Model, detail }
            };
            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
            await dialog.ShowAsync<AiLineageDetailDialog>("AI Extraction Detail", parameters, options);
        }
        catch
        {
            // Silently handle
        }
    }
}
