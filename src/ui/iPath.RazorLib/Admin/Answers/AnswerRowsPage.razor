@page "/admin/answers"
@attribute [Authorize(Roles = "Developer")]
@namespace iPath.Blazor.Componenents.Admin

@using iPath.Application.Features.Questionnaires.Queries
@using iPath.Application.Features.Questionnaires.Commands

@inject IPathApi api
@inject ISnackbar snackbar

<style>
    .answer-pivot { overflow-x: auto; border: 1px solid var(--mud-palette-divider); }
    .answer-pivot table { border-collapse: collapse; font-size: 0.8rem; white-space: nowrap; }
    .answer-pivot th, .answer-pivot td { border: 1px solid var(--mud-palette-divider); padding: 2px 6px; text-align: left; }
    .answer-pivot thead th { position: sticky; top: 0; background: var(--mud-palette-surface); z-index: 2; }
    /* items without a code are the form's own logic, not clinical concepts */
    .nocode { color: var(--mud-palette-text-secondary); font-style: italic; }
    .answer-pivot .casecol { position: sticky; left: 0; background: var(--mud-palette-surface); z-index: 1; }
    .answer-pivot thead th.casecol { z-index: 3; }
</style>

<MudBreadcrumbs Items="BreadCrumbs" Class="mt-0 pt-0"></MudBreadcrumbs>

<MudText Typo="Typo.h6" Class="mb-2">Data Export</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Pick a group to see its case description forms, the concepts they record (the catalog) and the
    answers its cases gave - one row per case, one column per concept.
</MudText>

<MudPaper Outlined="true" Class="pa-3 mb-4">
    <MudGrid Spacing="2" Class="d-flex align-center">
        <MudItem xs="12" sm="4">
            <GroupAdminLookup Label=@T["Group"] Clearable="true" @bind-Value="_group" @bind-Value:after="OnGroupChanged"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            @if (_catalog is not null)
            {
                <MudText Typo="Typo.body2">
                    @_catalog.CasesInGroup cases · @_catalog.Forms.Count forms · @_catalog.Concepts.Count concepts
                    (@NoCodeConcepts without code)
                </MudText>
            }
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Text" OnClick="Reload" Disabled="@(_group is null)"
                       StartIcon="@Icons.Material.Filled.Refresh">Reload</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_group is null)
{
    <MudAlert Severity="Severity.Info" Dense="true">
        Select a group. The catalog is built from the case description forms assigned to it.
    </MudAlert>
}
else if (_catalog is null)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else
{
    @if (_catalog.Warnings.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
            @foreach (var warning in _catalog.Warnings)
            {
                <div>@warning</div>
            }
        </MudAlert>
    }

    <MudExpansionPanels Elevation="1" Gutters="true" Class="mb-6">
        <MudExpansionPanel Dense="true" Text="@CatalogPanelTitle">
            <ChildContent>

                <MudText Typo="Typo.h6" Class="my-2">Forms</MudText>
                <MudTable Items="_catalog.Forms" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Form</MudTh>
                        <MudTh>Version</MudTh>
                        <MudTh>Assigned</MudTh>
                        <MudTh>Cases</MudTh>
                        <MudTh>Findings</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Form">
                            @context.Name
                            <MudText Typo="Typo.caption" Class="nocode">@context.QuestionnaireId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Version">v@context.Version</MudTd>
                        <MudTd DataLabel="Assigned">
                            @if (context.Assigned)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">used, not assigned</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Cases">@context.CasesWithAnswers</MudTd>
                        <MudTd DataLabel="Findings">
                            @if (context.Findings.Count > 0)
                            {
                                <MudTooltip>
                                    <ChildContent>
                                        <MudText Typo="Typo.body2">@context.Findings.Count</MudText>
                                    </ChildContent>
                                    <TooltipContent>
                                        @foreach (var f in context.Findings.Take(25))
                                        {
                                            <div>@f.Severity: @(f.LinkId ?? "-") - @f.Message</div>
                                        }
                                    </TooltipContent>
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudStack Row AlignItems="AlignItems.Center" Class="my-4" Spacing="2">
                    <MudText Typo="Typo.h6">Columns</MudText>
                    <MudTextField @bind-Value="conceptFilter" Immediate="true" Clearable="true"
                                  Placeholder="filter by label, code or linkId"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width: 280px" />
                    <MudCheckBox T="bool" @bind-Value="onlyUsed" Color="Color.Primary" Label=@T["only answered ones"] />
                    <MudSpacer />
                    <MudText Typo="Typo.body2">@_selectedColumns.Count selected</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectCodedColumns">@T["select all coded"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAnsweredColumns">@T["select answered"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearColumnSelection">@T["clear"]</MudButton>
                </MudStack>

                <MudTable Items="FilteredConcepts" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Use</MudTh>
                        <MudTh>Concept</MudTh>
                        <MudTh>Code</MudTh>
                        <MudTh>Type</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Use">
                            <MudCheckBox T="bool" Dense="true" Color="Color.Primary"
                                         Value="@_selectedColumns.Contains(context.Key)"
                                         ValueChanged="@(v => ToggleColumn(context, v))" />
                        </MudTd>
                        <MudTd DataLabel="Concept">
                            <span class="@(context.HasCode ? "" : "nocode")">@context.Display</span>
                            <MudText Typo="Typo.caption" Class="nocode">@string.Join(", ", context.LinkIds)</MudText>
                        </MudTd>
                        <MudTd DataLabel="Code">
                            <span class="nocode">@context.Code</span>
                        </MudTd>
                        <MudTd DataLabel="Type">@context.ValueType</MudTd>
                    </RowTemplate>
                </MudTable>

            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">Answers</MudText>
        <MudSelect T="string" Value="_formFilter" ValueChanged="OnFormFilterChanged" Clearable="true"
                   Placeholder=@T["all forms"] Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                   Style="min-width: 260px">
            @foreach (var form in _catalog.Forms)
            {
                <MudSelectItem T="string" Value="@form.QuestionnaireId">@form.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="search" Placeholder="which cases (linkId, code, value)" Clearable="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width: 280px"
                      @bind-Value:after="ReloadAnswers" />
        <MudSpacer />
        <MudSelect T="int" @bind-Value="_pageSize" @bind-Value:after="OnPageSizeChanged" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Dense="true" Style="width: 100px">
            <MudSelectItem T="int" Value="25">25</MudSelectItem>
            <MudSelectItem T="int" Value="50">50</MudSelectItem>
            <MudSelectItem T="int" Value="100">100</MudSelectItem>
        </MudSelect>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousPage" Disabled="@(_page == 0)"
                       Size="Size.Small" Title="Previous page" />
        <MudText Typo="Typo.body2">@PageInfo</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextPage" Disabled="@(!HasNextPage)"
                       Size="Size.Small" Title="Next page" />
    </MudStack>

    @if (_table is null || _table.Columns.Count == 0 || _table.Rows.TotalItems == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">No extracted answers match.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mb-1">
            @_table.Rows.TotalItems cases · @_table.Columns.Count columns
            @(_selectedColumns.Count > 0 ? "from the catalog" : "from the answers")
            · @NoCodeColumns without code. Empty cell = not answered;
            <span class="nocode">*</span> = question without a code.
            @if (_table.ConceptsOutsideColumns > 0)
            {
                <text> @_table.ConceptsOutsideColumns concept(s) in the data are not in the selected columns.</text>
            }
        </MudText>

        <div class="answer-pivot">
            <table>
                <thead>
                    <tr>
                        <th class="casecol">Case</th>
                        <th>Created</th>
                        <th>Accession</th>
                        <th>Body site</th>
                        @foreach (var col in _table.Columns)
                        {
                            <th class="@(col.HasCode ? "" : "nocode")" title="@col.Key">@col.Display</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _table.Rows.Items)
                    {
                        <tr>
                            <td class="casecol">
                                <MudLink Href="@($"/request/{row.ServiceRequestId}")">
                                    @(string.IsNullOrEmpty(row.Title) ? "(untitled case)" : row.Title)
                                </MudLink>
                            </td>
                            <td>@row.CreatedOn?.ToString("yyyy-MM-dd")</td>
                            <td>@row.AccessionNo</td>
                            <td>@row.BodySite</td>
                            @foreach (var col in _table.Columns)
                            {
                                <td class="@(col.HasCode ? "" : "nocode")">
                                    @(row.Cells.TryGetValue(col.Key, out var cell) ? cell : "")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<MudDivider Class="my-6" />

<MudText Typo="Typo.h6" Class="mb-2">Extraction Issues</MudText>
<MudText Typo="Typo.body2" Class="mb-3">
    Cases with a questionnaire response whose answers were never extracted or whose last attempt failed.
</MudText>

<MudGrid Spacing="2" Class="d-flex align-center mb-2">
    <MudItem xs="12" sm="3">
        <MudNumericField @bind-Value="backfillMax" Label="Max cases per run" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Dense="true" Min="0" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="RunBackfill"
                   Disabled="backfillRunning" StartIcon="@Icons.Material.Filled.Refresh">
            @(backfillRunning ? "Extracting ..." : "Run backfill")
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudButton Variant="Variant.Text" OnClick="LoadIssues" StartIcon="@Icons.Material.Filled.Warning">
            Reload issues
        </MudButton>
    </MudItem>
</MudGrid>

@if (issues is null)
{
    <MudText Typo="Typo.body2">Not loaded yet.</MudText>
}
else if (issues.Count == 0)
{
    <MudAlert Severity="Severity.Success" Dense="true">No extraction issues found.</MudAlert>
}
else
{
    <MudTable Items="issues" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Case</MudTh>
            <MudTh>Form</MudTh>
            <MudTh>Extracted</MudTh>
            <MudTh>Rows</MudTh>
            <MudTh>Error</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Case">
                <MudLink Href="@($"/request/{context.ServiceRequestId}")">
                    @(string.IsNullOrEmpty(context.Title) ? context.ServiceRequestId.ToString() : context.Title)
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Form">
                @context.QuestionnaireId
                @if (context.QuestionnaireVersion.HasValue)
                {
                    <text> (v@context.QuestionnaireVersion)</text>
                }
            </MudTd>
            <MudTd DataLabel="Extracted">
                @(context.ExtractedOn.HasValue ? context.ExtractedOn.Value.ToString("yyyy-MM-dd HH:mm") : "never")
            </MudTd>
            <MudTd DataLabel="Rows">@(context.AnswerCount?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="Error">@context.Error</MudTd>
            <MudTd DataLabel="">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Refresh" Title="Re-extract this case"
                               OnClick="@(async () => await ReExtract(context.ServiceRequestId))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private GroupListDto? _group;
    private AnswerCatalogDto? _catalog;
    private AnswerTableDto? _table;
    private List<AnswerExtractionStateDto>? issues;
    private string? conceptFilter;
    private bool onlyUsed;
    private readonly HashSet<string> _selectedColumns = new(StringComparer.OrdinalIgnoreCase);
    private string? _formFilter;
    private string? search;
    private int _page;
    private int _pageSize = 25;
    private int backfillMax = 100;
    private bool backfillRunning;

    public List<BreadcrumbItem> BreadCrumbs
    {
        get
        {
            var ret = new List<BreadcrumbItem> { new("Administration", href: "admin") };
            ret.Add(new("Data Export", href: null, disabled: true));
            return ret;
        }
    }

    private Guid? GroupId => _group?.Id;

    private string CatalogPanelTitle
        => $"Forms & columns - {_catalog?.Forms.Count ?? 0} forms, {_selectedColumns.Count} of {_catalog?.Concepts.Count ?? 0} columns selected";

    private int NoCodeConcepts => _catalog?.Concepts.Count(c => !c.HasCode) ?? 0;

    private int NoCodeColumns => _table?.Columns.Count(c => !c.HasCode) ?? 0;

    private IEnumerable<CatalogConceptDto> FilteredConcepts => _catalog is null
        ? []
        : _catalog.Concepts.Where(c =>
            (!onlyUsed || c.AnsweredCases > 0)
            && (string.IsNullOrWhiteSpace(conceptFilter)
                || c.Display.Contains(conceptFilter, StringComparison.OrdinalIgnoreCase)
                || (c.Code is not null && c.Code.Contains(conceptFilter, StringComparison.OrdinalIgnoreCase))
                || c.LinkIds.Any(l => l.Contains(conceptFilter, StringComparison.OrdinalIgnoreCase))));

    /// <summary>The columns picked in the catalog, in catalog order; null while nothing is picked.</summary>
    private AnswerColumnDto[]? SelectedColumns => _catalog is null || _selectedColumns.Count == 0
        ? null
        : _catalog.Concepts
            .Where(c => _selectedColumns.Contains(c.Key))
            .Select(c => new AnswerColumnDto(c.Key, c.CodeSystem, c.Code, c.Display, c.HasCode))
            .ToArray();

    private bool HasNextPage => _table is not null && (_page + 1) * _pageSize < _table.Rows.TotalItems;

    private string PageInfo => _table is null || _table.Rows.TotalItems == 0
        ? string.Empty
        : $"{_page * _pageSize + 1}-{Math.Min((_page + 1) * _pageSize, _table.Rows.TotalItems)} of {_table.Rows.TotalItems}";

    private async Task Reload()
    {
        _page = 0;
        _table = null;
        _catalog = null;

        if (_group is null)
        {
            issues = null;
            return;
        }

        await LoadCatalog();
        await LoadAnswers();
        await LoadIssues();
    }

    private async Task LoadCatalog()
    {
        var resp = await api.GetAnswerCatalog(new GetAnswerCatalogQuery(_group!.Id));
        if (resp.IsSuccessful && resp.Content is not null) _catalog = resp.Content;
        else snackbar.AddWarning(resp.ErrorText());
    }

    private async Task ReloadAnswers()
    {
        _page = 0;
        await LoadAnswers();
    }

    private async Task LoadAnswers()
    {
        var resp = await api.GetAnswerTable(new GetAnswerTableQuery
        {
            GroupId = GroupId,
            QuestionnaireId = _formFilter,
            SearchString = search,
            Columns = SelectedColumns,
            Page = _page,
            PageSize = _pageSize
        });

        if (resp.IsSuccessful && resp.Content is not null) _table = resp.Content;
        else snackbar.AddWarning(resp.ErrorText());
    }

    private async Task OnGroupChanged()
    {
        // a selection belongs to the catalog of one group
        _selectedColumns.Clear();
        await Reload();
    }

    private async Task ToggleColumn(CatalogConceptDto concept, bool selected)
    {
        if (selected) _selectedColumns.Add(concept.Key);
        else _selectedColumns.Remove(concept.Key);

        await LoadAnswers();
    }

    private Task SelectCodedColumns()
        => SetSelection(_catalog?.Concepts.Where(c => c.HasCode).Select(c => c.Key) ?? []);

    private Task SelectAnsweredColumns()
        => SetSelection(_catalog?.Concepts.Where(c => c.AnsweredCases > 0).Select(c => c.Key) ?? []);

    private Task ClearColumnSelection() => SetSelection([]);

    private async Task SetSelection(IEnumerable<string> keys)
    {
        _selectedColumns.Clear();
        foreach (var key in keys) _selectedColumns.Add(key);

        await LoadAnswers();
    }

    private async Task OnFormFilterChanged(string? value)
    {
        _formFilter = value;
        await ReloadAnswers();
    }

    private async Task PreviousPage()
    {
        if (_page > 0)
        {
            _page--;
            await LoadAnswers();
        }
    }

    private async Task NextPage()
    {
        if (HasNextPage)
        {
            _page++;
            await LoadAnswers();
        }
    }

    private async Task OnPageSizeChanged()
    {
        _page = 0;
        await LoadAnswers();
    }

    private async Task LoadIssues()
    {
        if (_group is null)
        {
            issues = null;
            return;
        }

        var resp = await api.GetAnswerIssues(GroupId, 200);
        issues = resp.IsSuccessful ? resp.Content ?? new() : new();
    }

    private async Task RunBackfill()
    {
        try
        {
            backfillRunning = true;
            var resp = await api.BackfillAnswers(new BackfillServiceRequestAnswersCommand(100, backfillMax));
            if (resp.IsSuccessful && resp.Content is not null)
            {
                snackbar.Add($"Scanned {resp.Content.CasesScanned}, extracted {resp.Content.CasesExtracted}, wrote {resp.Content.AnswersWritten} answers", Severity.Success);
            }
            else
            {
                snackbar.AddWarning(resp.ErrorText());
            }

            await Reload();
        }
        finally
        {
            backfillRunning = false;
        }
    }

    private async Task ReExtract(Guid caseId)
    {
        var resp = await api.ReExtractAnswers(caseId);
        if (resp.IsSuccessful)
        {
            snackbar.Add($"{resp.Content} answers extracted", Severity.Success);
        }
        else
        {
            snackbar.AddWarning(resp.ErrorText());
        }

        await Reload();
    }
}
