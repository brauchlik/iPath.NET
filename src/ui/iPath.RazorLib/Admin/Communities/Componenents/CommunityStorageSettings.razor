@namespace iPath.Blazor.Componenents.Admin.Community
@using iPath.Application.Features.Storage
@using iPath.Blazor.ServiceLib.ApiClient

@inject IPathApi api
@inject ISnackbar snackbar
@inject IDialogService dialogs

<MudPaper Outlined="true" Class="pa-4 mt-8">
    <MudText Typo="Typo.h6">Storage</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        Files of this community are stored in <b>@CurrentLabel</b>.
        Changing it moves all existing files in the background; they stay readable until each is moved.
        This is separate from <i>Save</i> below, which never changes the storage.
    </MudText>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudSelect T="string" Label="Storage instance" @bind-Value="_selected" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:360px">
            @foreach (var instance in _instances)
            {
                <MudSelectItem Value="@instance.Name">@instance.Name (@instance.Type@(instance.IsDefault ? ", default" : ""))</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(_busy || _selected is null || _selected == Current)" OnClick="ChangeAsync">
            Change storage and migrate
        </MudButton>
    </MudStack>

    @if (_selected is not null && _selected != Current)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
            Not applied yet: click <b>Change storage and migrate</b> to move this community to @_selected.
        </MudAlert>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid CommunityId { get; set; }
    [Parameter] public string? StorageInstance { get; set; }

    List<StorageInstanceDto> _instances = [];
    string? _selected;
    string? _current;
    bool _busy;

    string? Current => _current ?? _instances.FirstOrDefault(i => i.IsDefault)?.Name;
    string CurrentLabel => _current is null ? $"{Current} (server default)" : _current;

    protected override async Task OnInitializedAsync()
    {
        var res = await api.GetStorageInstances();
        _instances = res.Content ?? [];
    }

    protected override void OnParametersSet()
    {
        _current = StorageInstance;
        _selected ??= Current;
    }

    private async Task ChangeAsync()
    {
        var confirmed = await dialogs.ShowMessageBoxAsync("Change storage",
            $"Move all files of this community from {Current} to {_selected}? This runs in the background; progress is shown on the System page (Storage tab).",
            yesText: "Change and migrate", cancelText: "Cancel");
        if (confirmed != true)
            return;

        _busy = true;
        var res = await api.ChangeCommunityStorage(new ChangeCommunityStorageCommand(CommunityId, _selected!));
        _busy = false;

        if (!res.IsSuccessStatusCode)
        {
            snackbar.Add(res.ErrorText(), Severity.Warning);
            return;
        }

        _current = _selected;
        snackbar.Add(res.Content is null
            ? $"Storage set to {_selected}; there were no files to move."
            : $"Storage set to {_selected}; {res.Content.Total} files are being moved.", Severity.Success);
    }
}
