@page "/admin/questionnaires/{id}"
@page "/admin/questionnaires/{id}/{mode}"
@using System.Threading.Tasks

@inject QuestionnaireAdminViewModel vm
@inject IQuestionnaireToTextServiceRegistry previewRegistry

<MudBreadcrumbs Items="vm.BreadCrumbs" Class="mt-0 pt-0"></MudBreadcrumbs>



@if (vm.SelectedQuestionnaire is null)
{
    <IPathHeader Title=@T["Questionnaire Administration"] />
}
else
{
    <!--
    <IPathHeader Title=@($"{vm.SelectedQuestionnaire.Name}, Version={vm.SelectedQuestionnaire.Version}")>
        <ActionContent>
            <MudFab StartIcon="@Icons.Material.Filled.Backspace" Href="admin/questionnaires" Size="Size.Small" />
        </ActionContent>
    </IPathHeader>
    -->

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true"
             TabPanelsClass="pa-6"
             Color="Color.Info" IconColor="Color.Surface"
             @bind-ActivePanelIndex="panelIndex">
        <MudTabPanel Text=@T["Settings"] Icon="@Icons.Material.Filled.Settings">
            <MudForm Model="@Model" Spacing="4">
                <MudStack Row Spacing="0">
                    <MudTextField @bind-Value="@Model.QuestionnaireId" Label=@T["Id"] ShrinkLabel="true" Required="true"
                                  Variant="Variant.Outlined" Disabled="true" Margin="Margin.Dense" />
                    <MudCheckBox @bind-Value="@Model.IsActive" Label=@T["active"] />
                </MudStack>

                <MudTextField @bind-Value="@Model.Name" Label=@T["Name"] ShrinkLabel="true" Required="true" Variant="Variant.Outlined" />


                <MudStack Row Class="mt-2" AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="Model.ResourceFileName" Label=@T["Quesiotnnaire File"] ReadOnly="true" 
                        ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudFileUpload @ref="_fileUpload" T="IBrowserFile" @bind-Files="Model.ResourceFile" OnFilesChanged="UploadFile">
                        <CustomContent Context="fileUpload">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_uploading"
                                       StartIcon="@Icons.Material.Filled.FileUpload"
                                       OnClick="@fileUpload.OpenFilePickerAsync">
                                FHIR
                            </MudButton>
                        </CustomContent>
                        @* The upload is sent to the API as soon as it is picked, so a chip listing the
                           selected file is noise. Replacing SelectedTemplate suppresses MudBlazor's
                           default chip list and shows progress instead. *@
                        <SelectedTemplate>
                            @if (_uploading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <MudText Typo="Typo.body2">@T["processing ..."]</MudText>
                            }
                        </SelectedTemplate>
                    </MudFileUpload>
                    <a href=@($"api/v1/fhir/Questionnaire/{Model.Id}")>
                        <MudButton StartIcon="@Icons.Material.Filled.Download" Color="Color.Primary" Variant="Variant.Filled">Download</MudButton>
                    </a>
                </MudStack>

                <MudStack Row AlignItems="AlignItems.Center">
                    <MudSelect T="string" @bind-Value="Model.Settings.TextPreviewService"
                               Variant="Variant.Outlined"
                               Label=@T["Text Preview Mode"]
                               ShrinkLabel="true"
                               Margin="Margin.Dense">
                        @foreach (var svc in _previewServices)
                        {
                            <MudSelectItem Value="@svc.Key">@svc.DisplayName</MudSelectItem>
                        }
                    </MudSelect>

                    <MudCheckBox T="bool" @bind-Value="Model.ExtractAnswersEnabled" Color="Color.Primary"
                                 Label=@T["Extract answers"] />
                </MudStack>


                <MudDivider Class="mt-4" />
                @* The FHIR source is rarely interesting, so it lives behind a collapsed panel.
                   MudExpansionPanel does not keep collapsed content alive, so the field is not
                   even created until the panel is opened. *@
                <MudExpansionPanels Elevation="0" Gutters="false">
                    <MudExpansionPanel Dense="true">
                        <TitleContent>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle1">FHIR Questionnaire Resource</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@ResourceSummary</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudTextField Value="@Model.Resource"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Typo="Typo.body2"
                                          Lines="20" />
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudForm>
        </MudTabPanel>
        <MudTabPanel Text=@T["Filter"] Icon="@Icons.Material.Filled.Filter">
            <TopoTreeFilter @bind-Filter="@Model.Settings.BodySiteFilter" @ref="_topoTree" />
        </MudTabPanel>
        <MudTabPanel Text=@T["Preview"] Icon="@Icons.Material.Filled.Preview">
            <iPath.LHCForms.LhcForm @ref="vm.PreviewForm" ReadOnly="false"
                                    Questionnaire="@Model.Resource" />

            <MudDivider Class="mt-8" />

            <MudStack Row Spacing="2" Class="mb-2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6" Class="mb-2">Text Preview</MudText>
                <MudSpacer />
                <MudSelect T="string" @bind-Value="Model.Settings.TextPreviewService"
                           Label=@T["Text Preview Mode"]
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           ShrinkLabel="true"
                           Class="flex-grow-1">
                    @foreach (var svc in _previewServices)
                    {
                        <MudSelectItem Value="@svc.Key">@svc.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton OnClick="CreateText" Variant="Variant.Filled" Color="Color.Primary">Generate text</MudButton>
                <MudButton OnClick="CheckExtraction" Variant="Variant.Outlined" Color="Color.Secondary">Check extraction</MudButton>
            </MudStack>

            @if (vm.ConformityChecked)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Extraction Check</MudText>
                    @if (vm.ConformityFindings.Count == 0)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">
                            No extraction problems found.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTable Items="vm.ConformityFindings" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Severity</MudTh>
                                <MudTh>Question (linkId)</MudTh>
                                <MudTh>Finding</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Severity">
                                    <MudChip T="string" Size="Size.Small" Color="@SeverityColor(context.Severity)">
                                        @context.Severity
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="linkId">@context.LinkId</MudTd>
                                <MudTd DataLabel="Finding">@context.Message</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            }

            <MudButtonGroup Class="mb-2">
                <MudButton Variant="previewMode == PreviewMode.Text ? Variant.Filled : Variant.Outlined"
                           OnClick="@(() => previewMode = PreviewMode.Text)">Text Preview</MudButton>
                <MudButton Variant="previewMode == PreviewMode.Json ? Variant.Filled : Variant.Outlined"
                           OnClick="@(() => previewMode = PreviewMode.Json)">Response JSON</MudButton>
            </MudButtonGroup>

            <MudPaper Elevation="2" Class="pa-4">
                @if (previewMode == PreviewMode.Text)
                {
                    @if (string.IsNullOrEmpty(vm.PreviewText))
                    {
                        <MudText Class="mud-text-muted">Click "Generate text" to preview.</MudText>
                    }
                    else
                    {
                        @((MarkupString)vm.PreviewText)
                    }
                }
                else
                {
                    @if (string.IsNullOrEmpty(vm.PreviewResponseJson))
                    {
                        <MudText Class="mud-text-muted">Click "Generate text" to see the response JSON.</MudText>
                    }
                    else
                    {
                        <MudTextField Value="@vm.PreviewResponseJson"
                                      ReadOnly="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Typo="Typo.body2"
                                      Lines="20" />
                    }
                }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>


    <MudStack Row Class="mt-2">
        <ProgressButton Text="Save" Icon="@Icons.Material.Filled.Save" OnClick="Save" />
        <MudButton Variant="Variant.Filled" OnClick="ReloadModel">Cancel</MudButton>
    </MudStack>
}


@code {
    enum PreviewMode { Text, Json }

    [Parameter]
    public string id { get; set; }

    [Parameter]
    public string mode { get; set; }

    QuestionnaireEntity q;
    EditQuestionnaireModel Model { get; set; } = new();
    // ConceptFilter BodySiteFilter = new();
    int panelIndex = 0;

    TopoTreeFilter _topoTree;
    PreviewMode previewMode = PreviewMode.Text;
    IReadOnlyList<TextPreviewServiceInfo> _previewServices = [];

    protected override async Task OnParametersSetAsync()
    {
        _previewServices = previewRegistry.GetAll();

        if (Guid.TryParse(id, out var guid))
        {
            await vm.Load(guid);
            Model = new EditQuestionnaireModel(vm.SelectedQuestionnaire);
        }
        panelIndex = mode switch
        {
            "preview" => 2,
            "filter" => 1,
            _ => 0
        };
        StateHasChanged();
    }

    async Task Save()
    {
        Model.Settings ??= new();
        // Model.Settings.BodySiteFilter = BodySiteFilter;

        if (_topoTree is not null)
        {
            _topoTree.SaveFilter();
            Model.Settings.BodySiteFilter = _topoTree.Filter;
        }

        await vm.Save(Model);
    }

    private void ReloadModel()
    {
        if (vm.SelectedQuestionnaire is not null)
            Model = new EditQuestionnaireModel(vm.SelectedQuestionnaire);
    }

    private bool _uploading;
    private MudFileUpload<IBrowserFile>? _fileUpload;

    private string ResourceSummary
    {
        get
        {
            var kb = string.IsNullOrEmpty(Model.Resource) ? 0 : Model.Resource.Length / 1024;
            return $"{Model.QuestionnaireId} | v{Model.Version} | {kb} KB";
        }
    }

    private async Task UploadFile(InputFileChangeEventArgs args)
    {
        _uploading = true;
        StateHasChanged();

        try
        {
            var res = await vm.UploadFile(args, Model);
            if (res.IsFailed)
            {
                snackbar.AddError(res.Errors.FirstOrDefault()?.Message ?? "upload failed");
            }
            else
            {
                // the handler created a new version - rebind the model to the persisted one
                ReloadModel();
                snackbar.Add(T["Questionnaire uploaded"], Severity.Success);
            }
        }
        finally
        {
            _uploading = false;

            // drop the file from the selection: clears the bound field and resets the native
            // input, so picking the same file again raises a change event
            if (_fileUpload is not null)
            {
                await _fileUpload.ClearAsync();
            }

            StateHasChanged();
        }
    }

    private async Task CreateText(MouseEventArgs args)
    {
        await vm.GetPreviewText();
        StateHasChanged();
    }

    private async Task CheckExtraction()
    {
        await vm.CheckConformity();
        StateHasChanged();
    }

    private static Color SeverityColor(string? severity) => severity switch
    {
        "error" => Color.Error,
        "warning" => Color.Warning,
        _ => Color.Info
    };
}