@page "/admin/sync-import/{GroupId:int}"
@attribute [Authorize(Roles = "Developer")]

@using iPath.Application.Features.SyncImport
@using iPath.Blazor.ServiceLib.ApiClient
@inject IPathApi api
@inject NavigationManager nm
@inject ISnackbar snackbar
@inject IDialogService dialog

<MudText Typo="Typo.h5" Class="mb-4">Sync Import — Group Detail</MudText>

<MudButton Variant="Variant.Outlined"
           Color="Color.Default"
           Size="Size.Small"
           StartIcon="@Icons.Material.Filled.ArrowBack"
           OnClick="@GoBack"
           Class="mb-4">
    Back to group list
</MudButton>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    <MudText Class="mt-2">Loading group status...</MudText>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_status is not null)
{
    <MudCard Class="mb-4" Elevation="2">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-4">@_status.GroupName</MudText>
            <div class="mb-4" style="display: grid; grid-template-columns: 200px auto; gap: 8px;">
                <MudText Typo="Typo.body2" Class="font-weight-bold">Root Objects</MudText>
                <MudText Typo="Typo.body2">@_status.OldRootCount total (@_status.SyncedRootCount synced, @_status.RemainingRootCount remaining)</MudText>
                <MudText Typo="Typo.body2" Class="font-weight-bold">Annotations</MudText>
                <MudText Typo="Typo.body2">@_status.AnnotationCount</MudText>
                <MudText Typo="Typo.body2" Class="font-weight-bold">Users</MudText>
                <MudText Typo="Typo.body2">@_status.UserCount</MudText>
            </div>
            @if (_isSyncing)
            {
                <MudProgressLinear Determinate="true" Value="@_syncPercent" Color="Color.Primary" Class="mt-2" />
                <div class="d-flex align-center mt-2" style="gap: 8px;">
                    <MudText Typo="Typo.body2">@_syncStatus</MudText>
                    <MudText Typo="Typo.body2">(@_syncPercent%)</MudText>
                </div>
            }
            else
            {
                <div class="d-flex" style="gap: 12px;">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               OnClick="@StartSync">
                        Sync Group
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteForever"
                               OnClick="@StartDelete">
                        Remove imported data
                    </MudButton>
                </div>
            }
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public int GroupId { get; set; }

    private GroupImportStatus? _status;
    private bool _isLoading = true;
    private bool _isSyncing;
    private string? _error;
    private int _syncCurrent;
    private int _syncTotal;
    private string _syncStatus = "";
    private int _syncPercent => _syncTotal > 0 ? (int)(_syncCurrent * 100.0 / _syncTotal) : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        _isLoading = true;
        try
        {
            var resp = await api.GetGroupImportStatus(GroupId);
            if (resp.IsSuccessful && resp.Content is not null)
                _status = resp.Content;
            else
                _error = resp.Error?.Message ?? "Failed to load group status";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load group status: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        nm.NavigateTo("/admin/sync-import");
    }

    private async Task StartSync()
    {
        var confirmed = await dialog.ShowMessageBoxAsync("Sync Group",
            $"Import all nodes from \"{_status?.GroupName}\" ({_status?.OldRootCount} roots)?",
            yesText: "Sync", cancelText: "Cancel");
        if (confirmed != true) return;

        _isSyncing = true;
        _syncCurrent = 0;
        _syncTotal = _status?.OldRootCount ?? 1;
        _syncStatus = "Starting...";
        StateHasChanged();

        try
        {
            var start = await api.StartSync(GroupId);
            if (!start.IsSuccessful)
            {
                snackbar.Add($"Failed to start sync: {start.Error?.Message}", Severity.Error);
                return;
            }

            while (true)
            {
                await Task.Delay(2000);
                var job = await api.GetSyncJobStatus();
                if (!job.IsSuccessful || job.Content is null) break;
                if (job.Content.IsDone) break;
                if (job.Content.Error is not null)
                    throw new InvalidOperationException($"Sync failed: {job.Content.Error}");
                _syncCurrent = job.Content.Current;
                _syncTotal = job.Content.Total;
                _syncStatus = job.Content.Status;
                StateHasChanged();
            }
            snackbar.Add($"Sync complete for \"{_status?.GroupName}\"", Severity.Success);
            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            snackbar.Add($"Sync failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private async Task StartDelete()
    {
        var confirmed = await dialog.ShowMessageBoxAsync("Remove imported data",
            $"Delete ALL synced data for \"{_status?.GroupName}\"?\n\n" +
            $"This will remove all root objects, documents, annotations, and group members.\n" +
            $"Use 'Sync Group' afterward to re-import.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        _isSyncing = true;
        _syncCurrent = 0;
        _syncTotal = _status?.OldRootCount ?? 1;
        _syncStatus = "Deleting...";
        StateHasChanged();

        try
        {
            var start = await api.DeleteImport(GroupId);
            if (!start.IsSuccessful)
            {
                snackbar.Add($"Failed to start delete: {start.Error?.Message}", Severity.Error);
                return;
            }

            while (true)
            {
                await Task.Delay(2000);
                var job = await api.GetSyncJobStatus();
                if (!job.IsSuccessful || job.Content is null) break;
                if (job.Content.IsDone) break;
                if (job.Content.Error is not null)
                    throw new InvalidOperationException($"Delete failed: {job.Content.Error}");
                _syncCurrent = job.Content.Current;
                _syncTotal = job.Content.Total;
                _syncStatus = job.Content.Status;
                StateHasChanged();
            }
            snackbar.Add($"Imported data removed for \"{_status?.GroupName}\"", Severity.Success);
            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncing = false;
        }
    }
}
