@page "/admin/sync-import"
@attribute [Authorize(Roles = "Developer")]

@using iPath.Application.Features.SyncImport
@inject ISyncImportRunner syncImport
@inject NavigationManager nm
@inject ISnackbar snackbar
@inject IDialogService dialog

<MudText Typo="Typo.h5" Class="mb-4">Sync Import (from old iPath2)</MudText>

<MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
    Imports data from the old production MySQL. Only new items (not yet imported) are synced.
    Existing data is never modified.
</MudAlert>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    <MudText Class="mt-2">Loading groups from old system...</MudText>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_groups.Count == 0)
{
    <MudAlert Severity="Severity.Info">No groups found in old system, or the old MySQL connection is not configured.</MudAlert>
}
else
{
    <div Class="d-flex align-center mb-4" style="gap: 12px;">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_selectedIds.Count == 0 || _isSyncing)"
                   OnClick="@StartMultiSync">
            Sync Selected (@_selectedIds.Count)
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   OnClick="@(() => _selectedIds.Clear())">
            Clear Selection
        </MudButton>
        @if (_isSyncing)
        {
            <MudProgressLinear Determinate="true" Value="@_syncProgress" Class="flex-grow-1" />
            <MudText Typo="Typo.body2">@_syncProgress%</MudText>
        }
    </div>

    <MudDataGrid T="OldGroupSummary" Virtualize="true" Height="720" @ref="grid"
                    Items="@_groups"
                    MultiSelection="true" SelectedItemsChanged="@SelectedItemsChanged"
                    RowClick="@onRowClicked"
                    Dense="true"
                    Hover="true">
        <Columns>
            <SelectColumn />
            <PropertyColumn Property="x => x.Id" />
            <PropertyColumn Property="x => x.Name" />
            <PropertyColumn Property="x => x.Name" />
            <PropertyColumn Property="x => x.RootNodeCount" Title="Cases" />
            <PropertyColumn Property="x => x.Entered" Title="Created" Format="d" />
        </Columns>
    </MudDataGrid>
}

@code {
    private List<OldGroupSummary> _groups = [];
    private HashSet<int> _selectedIds = [];

    private MudDataGrid<OldGroupSummary> grid;

    private bool _isLoading = true;
    private bool _isSyncing;
    private double _syncProgress;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _groups = await syncImport.GetOldGroupSummariesAsync();
            _groups = [.. _groups.OrderBy(g => g.Name)];
        }
        catch (Exception ex)
        {
            _error = $"Failed to load groups: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // private void NavToGroup(int groupId)
    // {
    //     nm.NavigateTo($"/admin/sync-import/{groupId}");
    // }

    // private void ToggleSelect(int id, bool selected)
    // {
    //     if (selected) _selectedIds.Add(id);
    //     else _selectedIds.Remove(id);
    // }

    // private void OnSelectAllChanged(bool v)
    // {
    //     if (v) _selectedIds = [.. _groups.Select(g => g.Id)];
    //     else _selectedIds = [];
    // }

    private void SortGroups(bool ascending)
    {
        _groups = ascending
            ? [.. _groups.OrderBy(g => g.Name)]
            : [.. _groups.OrderByDescending(g => g.Name)];
    }

    private async Task StartMultiSync()
    {
        if (_selectedIds.Count == 0) return;
        var ids = _selectedIds.ToList();
        var confirmed = await dialog.ShowMessageBoxAsync("Sync Groups",
            $"Import all nodes from {ids.Count} selected group(s)?",
            yesText: "Sync", cancelText: "Cancel");
        if (confirmed != true) return;

        _isSyncing = true;
        _syncProgress = 0;
        var total = ids.Count;
        var completed = 0;

        StateHasChanged();

        try
        {
            foreach (var gid in ids)
            {
                var name = _groups.FirstOrDefault(g => g.Id == gid)?.Name ?? $"Group #{gid}";
                snackbar.Add($"Syncing {name}...", Severity.Info);
                _syncProgress = Math.Round((double)completed / total * 100, 1);
                StateHasChanged();
                await syncImport.SyncGroupAsync(new SyncStartRequest(gid));
                completed++;
            }
            snackbar.Add($"Sync completed for {completed} group(s)", Severity.Success);
            _selectedIds.Clear();
            _groups = await syncImport.GetOldGroupSummariesAsync();
            _groups = [.. _groups.OrderBy(g => g.Name)];
        }
        catch (Exception ex)
        {
            snackbar.Add($"Sync failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncing = false;
        }
    }

    void onRowClicked(DataGridRowClickEventArgs<OldGroupSummary> args)
    {
        nm.NavigateTo($"/admin/sync-import/{args.Item.Id}");
    }

    private void SelectedItemsChanged(HashSet<OldGroupSummary> items)
    {
        _selectedIds = items.Select(x => x.Id).ToHashSet();
    }
}
