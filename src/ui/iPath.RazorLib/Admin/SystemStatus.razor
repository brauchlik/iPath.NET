@page "/admin/system/status"

@using iPath.Application.Features.Admin
@using iPath.Blazor.ServiceLib.ApiClient

<IPathHeader Title="System Status" />

<MudTabs Position="Position.Top" Class="mt-4">
    <MudTabPanel Text="System Status">
        <MudText Typo="Typo.h6" Class="mb-4 mt-4">WSI Conversion Jobs (Last 10)</MudText>
        <MudDataGrid Items="conversionJobs" T="WsiConversionJobDto" Dense="true" Striped="true" Hover="true">
            <Columns>
                <PropertyColumn Property="x => x.CreatedOn" Title="Created On" Format="g" />
                <PropertyColumn Property="x => x.DocumentId" Title="Document ID" />
                <PropertyColumn Property="x => x.Filename" Title="Filename" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        @switch (context.Item.Status)
                        {
                            case WsiConversionStatus.Completed:
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Completed</MudChip>
                                break;
                            case WsiConversionStatus.Failed:
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                                break;
                            case WsiConversionStatus.Converting:
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">Converting</MudChip>
                                break;
                            case WsiConversionStatus.Downloading:
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">Downloading</MudChip>
                                break;
                            default:
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">@context.Item.Status</MudChip>
                                break;
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.ErrorMessage" Title="Error Message" />
                <PropertyColumn Property="x => x.RetryCount" Title="Retries" />
            </Columns>
        </MudDataGrid>

        <MudText Typo="Typo.h6" Class="mb-4 mt-6">Deleted Documents with Files</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mb-4" Disabled="@(!deletedDocs.Any())" OnClick="HandlePurgeAll">Purge All</MudButton>
        <MudDataGrid Items="deletedDocs" T="PurgeDocumentFileDto" Dense="true" Striped="true" Hover="true">
            <Columns>
                <PropertyColumn Property="x => x.Filename" Title="Filename" />
                <PropertyColumn Property="x => x.DeletedOn" Title="Deleted On" Format="g" />
                <TemplateColumn Title="Temp File">
                    <CellTemplate>
                        @if (context.Item.HasTempFile)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@FormatSize(context.Item.TempFileSize)</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">-</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="DZI">
                    <CellTemplate>
                        @if (context.Item.HasDziFolder)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@FormatSize(context.Item.DziFolderSize)</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">-</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Staging">
                    <CellTemplate>
                        @if (context.Item.HasStagingDir)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@FormatSize(context.Item.StagingDirSize)</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">-</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Action">
                    <CellTemplate>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   OnClick="() => HandlePurgeDocument(context.Item.DocumentId)">
                            Purge
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="Cache Management">
        @if (_cacheOverview is null)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="my-4" />
        }
        else
        {
            <MudText Typo="Typo.h6" Class="mb-4 mt-4">Cache Overview</MudText>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.body2">
                            <strong>Cache size:</strong> @FormatSize(_cacheOverview.TotalSize) / @FormatSize(_cacheOverview.MaxSize)
                        </MudText>
                        <MudProgressLinear Value="@CachePercent()" Color="Color.Primary" Class="my-2" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.body2">
                            <strong>Entries:</strong> @_cacheOverview.EntryCount
                            (@_cacheOverview.CheapCount cheap, @_cacheOverview.ExpensiveCount expensive)
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.body2">
                            <strong>Free disk:</strong> @FormatSize(_cacheOverview.FreeDiskBytes)
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.body2">
                            <strong>Temp path:</strong> @_cacheOverview.TempPath
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <div class="d-flex gap-4 mb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           Disabled="@_isEvicting" OnClick="HandleEvictCache">
                    @if (_isEvicting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Run Eviction Now
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                           Disabled="@_isSyncing" OnClick="HandleSyncCache">
                    @if (_isSyncing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Sync Cache with Disk
                </MudButton>
            </div>

            @if (_syncResult is not null)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4" Dismissible="true">
                    @_syncResult.Details.Count changes:
                    @_syncResult.EntriesRemoved stale entries removed,
                    @_syncResult.EntriesCreated entries created for missing files,
                    @_syncResult.OrphansDeleted orphan files deleted.
                </MudAlert>
            }

            @if (_evictionResult is not null)
            {
                <MudAlert Severity="@(_evictionResult.Value ? Severity.Success : Severity.Warning)" Class="mb-4" Dismissible="true">
                    @if (_evictionResult.Value)
                    {
                        <text>Cache eviction completed successfully.</text>
                    }
                    else
                    {
                        <text>Cache eviction returned false.</text>
                    }
                </MudAlert>
            }
        }
    </MudTabPanel>
</MudTabs>

@inject IPathApi api

@code {
    List<WsiConversionJobDto> conversionJobs = new();
    List<PurgeDocumentFileDto> deletedDocs = new();
    CacheOverviewDto? _cacheOverview;
    bool _isEvicting;
    bool _isSyncing;
    bool? _evictionResult;
    CacheSyncResult? _syncResult;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var jobsRes = await api.GetWsiConversionJobs();
            if (jobsRes.IsSuccessStatusCode && jobsRes.Content != null)
                conversionJobs = jobsRes.Content;

            var deletedRes = await api.GetDeletedDocumentsWithFiles();
            if (deletedRes.IsSuccessStatusCode && deletedRes.Content != null)
                deletedDocs = deletedRes.Content;

            var cacheRes = await api.GetCacheOverview();
            if (cacheRes.IsSuccessStatusCode && cacheRes.Content != null)
                _cacheOverview = cacheRes.Content;
        }
        catch
        {
        }
    }

    private async Task HandlePurgeDocument(Guid documentId)
    {
        var res = await api.PurgeDocumentFiles(documentId);
        if (res.IsSuccessStatusCode)
        {
            deletedDocs.RemoveAll(d => d.DocumentId == documentId);
        }
    }

    private async Task HandlePurgeAll()
    {
        foreach (var doc in deletedDocs.ToList())
        {
            var res = await api.PurgeDocumentFiles(doc.DocumentId);
            if (res.IsSuccessStatusCode)
                deletedDocs.Remove(doc);
        }
    }

    private async Task HandleEvictCache()
    {
        _isEvicting = true;
        _evictionResult = null;
        try
        {
            var res = await api.EvictCache();
            _evictionResult = res.IsSuccessStatusCode && res.Content == true;
            if (_evictionResult == true)
            {
                var cacheRes = await api.GetCacheOverview();
                if (cacheRes.IsSuccessStatusCode && cacheRes.Content != null)
                    _cacheOverview = cacheRes.Content;
            }
        }
        catch
        {
            _evictionResult = false;
        }
        _isEvicting = false;
    }

    private async Task HandleSyncCache()
    {
        _isSyncing = true;
        _syncResult = null;
        try
        {
            var res = await api.SyncCache();
            if (res.IsSuccessStatusCode && res.Content != null)
            {
                _syncResult = res.Content;
                var cacheRes = await api.GetCacheOverview();
                if (cacheRes.IsSuccessStatusCode && cacheRes.Content != null)
                    _cacheOverview = cacheRes.Content;
            }
        }
        catch
        {
        }
        _isSyncing = false;
    }

    private double CachePercent()
    {
        if (_cacheOverview is null || _cacheOverview.MaxSize <= 0) return 0;
        return Math.Min(100.0, (double)_cacheOverview.TotalSize / _cacheOverview.MaxSize * 100);
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }
}
