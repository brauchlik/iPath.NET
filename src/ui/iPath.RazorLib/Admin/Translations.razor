@page "/admin/translations"
@attribute [Authorize(Roles = "Admin")]
@using iPath.Application.Features.Admin
@using iPath.Application.Localization
@using iPath.Domain.Config

<IPathHeader Title="Translations Manager" />

<MudGrid Class="mt-2">
    <MudItem xs="12" md="6">
        @if (TargetLanguages.Length == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                No target language is configured (<code>LocalizationSettings:SupportedCultures</code>).
            </MudAlert>
        }
        else
        {
            <MudSelect T="string" Label="Select Target Language" Value="@_selectedLocale" ValueChanged="OnLocaleChangedAsync" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                @foreach (var locale in TargetLanguages)
                {
                    <MudSelectItem Value="@locale">@GetLanguageDisplayName(locale)</MudSelectItem>
                }
            </MudSelect>
        }
    </MudItem>

    @if (_translationStatus != null)
    {
        <MudItem xs="12" md="6">
            <MudCard Outlined="true" Class="h-100">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Stats for @GetLanguageDisplayName(_selectedLocale):</b></MudText>
                    <div class="d-flex justify-space-between mb-1">
                        <MudText>Total Keys:</MudText>
                        <MudText><b>@_translationStatus.TotalKeys</b></MudText>
                    </div>
                    <div class="d-flex justify-space-between mb-1">
                        <MudText>Translated Keys:</MudText>
                        <MudText><b>@_translationStatus.TranslatedKeys</b></MudText>
                    </div>
                    <div class="d-flex justify-space-between mb-1">
                        <MudText>Missing Keys:</MudText>
                        <MudText><b>@_translationStatus.MissingKeys</b></MudText>
                    </div>

                    @if (_translationStatus.MissingKeys > 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
                            @_translationStatus.MissingKeys phrase(s) still need translation.
                            @if (CanEdit)
                            {
                                <text>Edit them directly in the table below.</text>
                            }
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Class="mt-4" Dense="true">All phrases are translated!</MudAlert>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12">
            @if (!CanEdit)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    No separate live translation store is configured (<code>LocalizationSettings:LocalesRoot</code>).
                    Translations are read directly from the shipped files and cannot be edited here.
                </MudAlert>
            }
            <MudDataGrid Items="@_translationRows" T="TranslationRow" ReadOnly="@(!CanEdit)" EditMode="DataGridEditMode.Inline" EditTrigger="DataGridEditTrigger.Manual" RowsPerPage="25"
                         StartedEditingItem="@OnStartedEditingItem" CanceledEditingItem="@OnCanceledEditingItem"
                         CommittedItemChanges="@OnRowCommitted" QuickFilter="@_quickFilter" Dense="true" Striped="true" Hover="true" Class="mt-4" Elevation="1">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Phrase Repository</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search key or translation..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mt-0" Immediate="true" Clearable="true" />
                    @if (CanEdit)
                    {
                        <MudTooltip Text="Add keys missing from this locale and fill empty ones from the shipped defaults (never overwrites a translation)">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="ml-4 mt-0" StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="ImportDefaults">Import shipped defaults</MudButton>
                        </MudTooltip>
                    }
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Key" Title="English Key (Source)" Editable="false" />
                    <PropertyColumn Property="x => x.Translation" Title="Translation">
                        <EditTemplate>
                            <MudStack Spacing="0">
                                <MudTextField @bind-Value="context.Item.Translation"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                              Immediate="true" AutoFocus="true" Placeholder="Translation"
                                              Adornment="@(DiffersFromShipped(context.Item) ? Adornment.End : Adornment.None)"
                                              AdornmentIcon="@Icons.Material.Filled.Restore"
                                              OnAdornmentClick="@(() => context.Item.Translation = context.Item.Shipped)" />
                                @if (DiffersFromShipped(context.Item))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary ps-3">@context.Item.Shipped</MudText>
                                }
                            </MudStack>
                        </EditTemplate>
                    </PropertyColumn>
                    <TemplateColumn CellClass="d-flex justify-end">
                        <CellTemplate>
                            @if (DiffersFromShipped(context.Item))
                            {
                                <MudTooltip Text="@($"Original: {context.Item.Shipped}")">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                </MudTooltip>
                            }
                            @if (CanEdit)
                            {
                                @if (context.IsEditing)
                                {
                                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.Check" Color="Color.Success" aria-label="Save translation" OnClick="@context.Actions.CommitEditingItemAsync" />
                                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.Close" Color="Color.Error" aria-label="Cancel" OnClick="@context.Actions.CancelEditingItemAsync" />
                                }
                                else
                                {
                                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" aria-label="Edit translation" OnClick="@context.Actions.StartEditingItemAsync" />
                                }
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="TranslationRow" PageSizeOptions="new int[]{10, 25, 50, 100}" />
                </PagerContent>
            </MudDataGrid>
        </MudItem>
    }
    else if (!string.IsNullOrEmpty(_selectedLocale))
    {
        <MudItem xs="12">
            <MudText Class="mt-2">Loading translation status...</MudText>
        </MudItem>
    }
</MudGrid>

@inject IPathApi api
@inject IOptions<iPathClientConfig> clientConfig
@inject ITranslationLoader translationLoader
@inject IDialogService dialog
@inject ISnackbar snackbar

@code {
    private string _selectedLocale = string.Empty;
    private TranslationStatusDto? _translationStatus;
    private string _searchString = string.Empty;
    private List<TranslationRow> _translationRows = new();

    private bool CanEdit => _translationStatus?.IsEditable == true;

    /// <summary>
    /// Target languages come from iPathClientConfig, not LocalizationSettings: the latter is a
    /// server-only options type and is never bound in the WASM client, so reading it there left
    /// the picker empty. iPathClientConfig mirrors the same values and is sent to the client by
    /// /api/v1/config (see APIServicesRegistration's PostConfigure block) - LanguageMenu uses it too.
    /// </summary>
    private string[] TargetLanguages =>
        (clientConfig.Value.SupportedCultures ?? []).Where(c => c != "en").ToArray();

    private static bool DiffersFromShipped(TranslationRow row) =>
        !string.IsNullOrEmpty(row.Shipped) && row.Translation != row.Shipped;

    private Func<TranslationRow, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Key.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.Translation != null && x.Translation.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadTranslationStatusAsync();
    }

    private string GetLanguageDisplayName(string locale) =>
        clientConfig.Value.CultureDisplayNames.TryGetValue(locale.ToLowerInvariant(), out var name)
            ? $"{name} ({locale})"
            : locale.ToUpperInvariant();

    private async Task OnLocaleChangedAsync(string locale)
    {
        _selectedLocale = locale;
        _translationStatus = null;
        await LoadTranslationStatusAsync();
    }

    private async Task LoadTranslationStatusAsync()
    {
        if (string.IsNullOrEmpty(_selectedLocale))
        {
            var uiLocale = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            var supported = TargetLanguages.ToList();

            // Default to current UI language if it's a non-English supported culture
            _selectedLocale = supported.Contains(uiLocale) ? uiLocale : (supported.FirstOrDefault() ?? string.Empty);

            if (string.IsNullOrEmpty(_selectedLocale))
                return;
        }

        try
        {
            var response = await api.GetTranslationStatus(_selectedLocale);
            if (response.IsSuccessful && response.Content is not null)
            {
                _translationStatus = response.Content;
                _translationRows = _translationStatus.Words.Select(kvp => new TranslationRow
                {
                    Key = kvp.Key,
                    Translation = kvp.Value,
                    Shipped = _translationStatus.Defaults.TryGetValue(kvp.Key, out var shipped) ? shipped ?? string.Empty : string.Empty
                }).ToList();
            }
        }
        catch (Exception)
        {
            // Handle error silently or log
        }

        StateHasChanged();
    }

    private void OnStartedEditingItem(TranslationRow row) => StateHasChanged();

    private void OnCanceledEditingItem(TranslationRow row) => StateHasChanged();

    private async Task ImportDefaults()
    {
        var confirmed = await dialog.ShowMessageBoxAsync(
            "Import shipped defaults",
            $"Add keys missing from {GetLanguageDisplayName(_selectedLocale)} and fill empty ones from the shipped defaults? Existing translations are never overwritten.",
            yesText: "Import", cancelText: "Cancel");
        if (confirmed is null) return;

        var response = await api.ImportTranslationDefaults(new ImportTranslationDefaultsCommand(_selectedLocale));
        if (!response.IsSuccessful || response.Content is null)
        {
            snackbar.AddWarning(response.ErrorText());
            return;
        }

        snackbar.AddInfo($"{response.Content.TotalAdded} added, {response.Content.TotalFilled} filled");
        await translationLoader.LoadTranslationData(_selectedLocale, reload: true);
        await LoadTranslationStatusAsync();
    }

    private async Task<DataGridEditFormAction> OnRowCommitted(TranslationRow row)
    {
        try
        {
            var command = new UpdateTranslationKeyCommand(_selectedLocale, row.Key, row.Translation);
            var response = await api.UpdateTranslationKey(command);
            if (response.IsSuccessful && response.Content)
            {
                // Force localizer cache to reload
                await translationLoader.LoadTranslationData(_selectedLocale, reload: true);
            }
            else
            {
                await LoadTranslationStatusAsync();
            }
        }
        catch
        {
            await LoadTranslationStatusAsync();
        }
        StateHasChanged();
        return DataGridEditFormAction.Close;
    }

    public class TranslationRow
    {
        public string Key { get; set; } = string.Empty;
        public string Translation { get; set; } = string.Empty;
        public string Shipped { get; set; } = string.Empty;
    }
}
