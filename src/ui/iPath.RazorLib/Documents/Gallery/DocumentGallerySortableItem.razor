@namespace iPath.Blazor.Componenents.Documents


<MudPaper class="gallery-item" data-id="@Model.Id">
    @if (Model.IsImage || !string.IsNullOrEmpty(Model.File?.ThumbData))
    {
        <img src="@Model.ThumbUrl" alt="@Model.GalleryCaption.ShortenTo(25)">
    }
    else
    {
        <MudIcon Size="Size.Large" Icon="@Model.FileIcon" />
        <br />
    }
    <div class="gallery-item-label">@Model.File?.Filename.ShortenTo(12)</div>
    @if (Model.File?.ConversionStatus == DocumentConversionStatus.Converting || Model.File?.ConversionStatus == DocumentConversionStatus.Pending)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="gallery-converting-badge">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            Converting
        </MudChip>
    }
    else if (Model.File?.ConversionStatus == DocumentConversionStatus.Failed)
    {
        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" Class="gallery-error-icon" />
    }
    <MudCheckBox @bind-Value="@Selected" @bind-Value:after="OnSelectedChanged" Style="position: absolute; top: -12px; left: -12px;" />
</MudPaper>



@code {
    [Parameter]
    public DocumentDto Model { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback<bool> SelectedChanged { get; set; }

    async Task OnSelectedChanged()
    {
        await SelectedChanged.InvokeAsync(Selected);   
    }
}
