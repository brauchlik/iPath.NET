@namespace iPath.Blazor.Componenents.Documents
@using iPath.Application.Features.Admin
@using iPath.Blazor.Componenents.Shared
@using iPath.Blazor.ServiceLib.ApiClient

<MudDialog ContentStyle="width: min(640px, 90vw)">
    <TitleContent>
        <MudText Typo="Typo.h6">@T["Document Properties"]: @Model.File?.Filename</MudText>
    </TitleContent>
    <DialogContent>
        @if (_info is { StorageProviderMismatch: true })
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                @T["This file is stored on"] <b>@_info.StorageProvider</b>, @T["but its community uses"] <b>@_info.ExpectedStorage</b>.
                @T["It stays readable; a storage migration moves it (System → Storage)."]
            </MudAlert>
        }

        <MudText Typo="Typo.caption">
            <table class="ipath-debug-table">
                <tbody>
                    <tr><td class="pr-3">@T["Filename"]</td><td style="@Wrap">@Model.File?.Filename</td></tr>
                    <tr><td class="pr-3">@T["DocumentType"]</td><td>@Model.DocumentType</td></tr>
                    <tr><td class="pr-3">@T["MimeType"]</td><td>@(_info?.MimeType ?? Model.File?.MimeType)</td></tr>
                    @if (Model.Dimensions is { } size)
                    {
                        <tr><td class="pr-3">@T["Dimensions"]</td><td>@size.Width × @size.Height</td></tr>
                    }
                    <tr><td class="pr-3">@T["File size"]</td><td>@FileSize</td></tr>
                    @if (_info is not null)
                    {
                        <tr><td class="pr-3">@T["Storage"]</td><td>@(_info.StorageProvider ?? T["not stored yet"])</td></tr>
                        <tr><td class="pr-3">@T["Community storage"]</td><td>@_info.ExpectedStorage</td></tr>
                        <tr><td class="pr-3">@T["Storage key"]</td><td style="@Wrap">@_info.StorageId</td></tr>
                        @if (_info.RemotePath is not null && _info.RemotePath != _info.StorageId)
                        {
                            <tr><td class="pr-3">@T["Location"]</td><td style="@Wrap">@_info.RemotePath</td></tr>
                        }
                        <tr><td class="pr-3">@T["Stored on"]</td><td>@(_info.LastStorageExportDate?.ToLocalTime().ToString("g") ?? "-")</td></tr>
                        <tr><td class="pr-3">@T["In cache"]</td><td>@(_info.IsInCache ? T["yes"] : T["no"])</td></tr>
                        @if (_info.ConversionStatus is not null)
                        {
                            <tr><td class="pr-3">@T["Conversion"]</td><td>@_info.ConversionStatus</td></tr>
                        }
                        @foreach (var old in Model.File?.RetiredLocations ?? [])
                        {
                            <tr><td class="pr-3">@T["Old copy"]</td><td style="@Wrap">@old.ProviderName: @old.StorageId</td></tr>
                        }
                    }
                </tbody>
            </table>
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick=@(() => MudDialog.Close())>Close</MudButton>
    </DialogActions>
</MudDialog>


@inject IStringLocalizer T
@inject IPathApi api
@inject AppState appState

@code {
    private const string Wrap = "word-break:break-all";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public DocumentDto Model { get; set; }

    private DocumentStorageInfoDto? _info;

    protected override async Task OnInitializedAsync()
    {
        if (!appState.IsAdmin)
            return;
        var res = await api.GetDocumentStorageInfo(Model.Id);
        if (res.IsSuccessStatusCode)
            _info = res.Content;
    }

    private string FileSize => (_info?.FileSize ?? Model.File?.FileSize) is not { } bytes ? "-" : bytes switch
    {
        >= 1L << 30 => $"{bytes / (double)(1L << 30):0.0} GB",
        >= 1L << 20 => $"{bytes / (double)(1L << 20):0.0} MB",
        >= 1L << 10 => $"{bytes / 1024.0:0} KB",
        _ => $"{bytes} B",
    };
}
