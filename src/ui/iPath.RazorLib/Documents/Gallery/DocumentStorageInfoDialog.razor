@namespace iPath.Blazor.Componenents.Documents
@using iPath.Application.Features.Admin
@using iPath.Blazor.ServiceLib.ApiClient

@inject IPathApi api

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Storage Info: @(Model?.File?.Filename ?? "")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="my-2" />
        }
        else if (_storageInfo is not null)
        {
            @if (_storageInfo.StorageProviderMismatch == true)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4" Dismissible="false">
                    Storage provider mismatch: document is stored on <strong>@_storageInfo.StorageProvider</strong>,
                    but the system is currently using a different storage provider. The file may not be accessible.
                </MudAlert>
            }

            <MudText Typo="Typo.caption">
                <table class="ipath-debug-table">
                    <tbody>
                        <tr><td class="pr-3">In cache</td><td>@(_storageInfo.IsInCache ? "yes" : "no")</td></tr>
                        <tr><td class="pr-3">File size</td><td>@FormatFileSize(_storageInfo.FileSize ?? Model?.File?.FileSize ?? 0)</td></tr>
                        <tr><td class="pr-3">MIME type</td><td>@_storageInfo.MimeType</td></tr>
                        @if (_storageInfo.ImageWidth.HasValue)
                        {
                            <tr><td class="pr-3">Dimensions</td><td>@_storageInfo.ImageWidth × @_storageInfo.ImageHeight</td></tr>
                        }
                        <tr><td class="pr-3">Storage</td><td>@(_storageInfo.StorageProvider ?? "—")</td></tr>
                        @if (_storageInfo.StorageId is not null)
                        {
                            <tr><td class="pr-3">Storage ID</td><td style="word-break:break-all;max-width:300px">@_storageInfo.StorageId</td></tr>
                        }
                        @if (_storageInfo.RemotePath is not null)
                        {
                            <tr><td class="pr-3">Remote path</td><td style="word-break:break-all;max-width:300px">@_storageInfo.RemotePath</td></tr>
                        }
                        <tr><td class="pr-3">Public URL</td><td style="word-break:break-all;max-width:300px">@(_storageInfo.PublicUrl ?? "—")</td></tr>
                        <tr><td class="pr-3">Last exported</td><td>@(_storageInfo.LastStorageExportDate?.ToString("g") ?? "—")</td></tr>
                        @if (_storageInfo.ConversionStatus is not null)
                        {
                            <tr><td class="pr-3">Conversion</td><td>@_storageInfo.ConversionStatus</td></tr>
                        }
                    </tbody>
                </table>
            </MudText>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public DocumentDto? Model { get; set; }

    private bool _loading = true;
    private DocumentStorageInfoDto? _storageInfo;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resp = await api.GetDocumentStorageInfo(Model!.Id);
            if (resp.IsSuccessful && resp.Content is not null)
                _storageInfo = resp.Content;
            else
                _error = "Failed to load storage info.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private static string FormatFileSize(long bytes)
    {
        return bytes switch
        {
            < 1024 => $"{bytes} B",
            < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
            < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):F1} MB",
            _ => $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB"
        };
    }
}
