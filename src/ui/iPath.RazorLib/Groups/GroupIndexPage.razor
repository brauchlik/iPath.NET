@page "/groups/{groupId}"

@attribute [Authorize]

@inject GroupViewModel vm
@if (Model is null)
{
    <LoadingMessage />
}
else
{
    <IPathHeader Title="@vm.Model.Name" Typo="Typo.h6" />

    <ServiceRequestListView GroupId="@vm.Model.Id" ListMode="eRequestFilter.Group" />

    <!--
    <MudHidden Breakpoint="Breakpoint.SmAndUp">
        <ServiceRequestCompactList GroupId="@vm.Model.Id" ListMode="eRequestFilter.Group" />
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.Xs">
        <ServiceRequestListTable GroupId="@vm.Model.Id" ListMode="eRequestFilter.Group" />
    </MudHidden>
    -->
}


@code {
    [Parameter]
    public string groupId { get; set; }

    [Parameter]
    public GroupDto Model { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(groupId))
        {
            _ = LoadGroupAsync();
        }
    }

    private async Task LoadGroupAsync()
    {
        await vm.LoadGroup(Guid.Parse(groupId));
        Model = vm.Model;
        await InvokeAsync(StateHasChanged);
    }}
