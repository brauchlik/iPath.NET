@inject IOptions<iPath.Application.Localization.LocalizationSettings> locOpts
@inject NavigationManager nm
@inject iPath.Blazor.Componenents.Shared.AppState appState
@inject iPath.Blazor.ServiceLib.ApiClient.IPathApi api
@inject ILogger<LanguageMenu> logger

<MudMenu StartIcon="@Icons.Material.Filled.Language" Label="@Label" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
    @foreach (var item in _menuItems)
    {
        <MudMenuItem @key="item.Code" OnClick='() => SwitchLanguage(item.Code)'>
            @item.DisplayName
        </MudMenuItem>
    }
</MudMenu>

@code {
    private record MenuItem(string Code, string DisplayName);

    private string locale => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private string Label => $"[{locale?.ToUpperInvariant()}]";

    private MenuItem[] _menuItems = Array.Empty<MenuItem>();

    protected override void OnInitialized()
    {
        var cultures = locOpts?.Value?.SupportedCultures;
        if (cultures != null)
        {
            _menuItems = cultures
                .Distinct()
                .Select(c => new MenuItem(c, locOpts.Value.CultureDisplayNames.TryGetValue(c, out var n) ? n : c))
                .ToArray();
        }
    }

    private async Task SwitchLanguage(string culture)
    {
        if (appState?.IsAuthenticated == true && appState.User is not null)
        {
            try
            {
                var userId = appState.User.Id;
                var userResp = await api.GetUser(userId);
                if (userResp.IsSuccessful && userResp.Content is not null)
                {
                    userResp.Content.Profile.DefaultLanguage = culture;
                    await api.UpdateProfile(new UpdateUserProfileCommand(userId, userResp.Content.Profile));
                }
            }
            catch (Exception ex)
            {
                logger.LogWarning(ex, "Failed to persist DefaultLanguage {Culture} for user {UserId}; cookie set will still take effect", culture, appState.User.Id);
            }
        }

        var uri = new Uri(nm.Uri);
        var localPath = uri.LocalPath + uri.Query;
        nm.NavigateTo($"/api/localization/set?culture={culture}&redirectUri={Uri.EscapeDataString(localPath)}", forceLoad: true);
    }
}
