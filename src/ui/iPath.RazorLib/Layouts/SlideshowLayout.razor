@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider IsDarkMode="true" />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudDialogProvider MaxWidth="MaxWidth.Medium"
                   CloseButton="true"
                   BackdropClick="false"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true" />

<AuthorizeView>
    <Authorized>
        <SseConnectionHost />
    </Authorized>
</AuthorizeView>

<MudLayout Style="background-color: black;" Class="pa-0">
    <MudMainContent Style="padding-top: 8px !important; background-color: black;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", "var el = document.getElementById('loading-screen'); if (el) { el.remove(); }");
            }
            catch
            {
                // Ignore exceptions on prerendering
            }
        }
    }
}
