@namespace iPath.Blazor.Componenents.Questionaires

@inject ServiceRequestViewModel vm

<QuestionnaireFormHost ReadOnly="true" Renderer="renderer" @ref="frm" />

@code {
    [Parameter, EditorRequired]
    public QuestionnaireResponseData Data { get; set; }

    QuestionnaireFormHost frm;
    QuestionnaireRenderer renderer = QuestionnaireRenderer.LForms;
    string? q;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    public async Task LoadDataAsync()
    {
        if (frm is not null)
        {
            q = await vm.GetQuesiotnnaireResource(Data.QuestionnaireId, Data.Version);
            renderer = await vm.GetQuestionnaireRenderer(Data.QuestionnaireId, Data.Version);
            await frm.LoadFormAsync(q, Data.Resource);
        }
    }
}
