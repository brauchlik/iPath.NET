@page "/q"

@inject IPathApi api
@inject ISnackbar snackbar

<h3>QuestionnaireTestPage</h3>

<MudToggleGroup T="QuestionnaireRenderer" @bind-Value="renderer">
    <MudToggleItem Value="QuestionnaireRenderer.LForms" Text="LForms" />
    <MudToggleItem Value="QuestionnaireRenderer.Native" Text="Native (iPath.BlazorForm)" />
</MudToggleGroup>

<QuestionnaireFormHost @ref="form" Renderer="renderer" ReadOnly="false" />


@code {
    QuestionnaireFormHost form;
    QuestionnaireRenderer renderer = QuestionnaireRenderer.LForms;

    protected override async Task OnInitializedAsync()
    {
        var resp = await api.GetQuestionnaire("followup");
        if (resp.IsSuccessful)
        {
            await form.LoadFormAsync(resp.Content.Resource, "");
        }
        else
        {
            snackbar.AddError(resp.ErrorText());
        }
    }
}
