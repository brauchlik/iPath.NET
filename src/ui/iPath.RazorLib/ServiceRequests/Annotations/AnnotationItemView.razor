@namespace iPath.Blazor.Componenents.ServiceRequests

@inherits ServiceRequestViewComponentBase

@inject IDialogService srvDialog
@inject UserViewModel uvm
@inject ServiceRequestViewModel vm

@if (editModel is null)
{
    <div class="ipath_annotation_block @CssClass">
        <div class="ipath_annotation_info">
            <div class="ipath_annotation_info1"><OwnerLink Owner="@Item.Owner" /></div>
            <div class="ipath_annotation_info2">@Item.CreatedOn.ToString("g")</div>
            @if (Item.Deleted)
            {
                <div class="ipath_annotation_deletedinfo">@T["deleted"]</div>
            }
            else
            {
                <div class="ipath_annotation_actions">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"  hidden="@(!CanEditAnnotation)" OnClick="Edit" />
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" hidden="@(!CanDeleteAnnotation)" OnClick="Delete" />
                </div>
            }
        </div>
        <div class="@TextClass">
            @if (Item.Data?.Questionnaire is not null)
            {
                <QuestionnaireResponseView Data="Item.Data.Questionnaire" />
            }

            @if (Item.Data.Type != eAnnotationType.Comment)
            {
                <div class="ipath_annotation_type">@Item.Data.Type</div>
            }

            <div class="ipath_annotation_textboby">
                @((MarkupString)Item.Data.Text)
            </div>

            @if (Item.Data?.Morphology is not null)
            {
                <div class="morphology_code"><b>Morphology:</b> @Item.Data.Morphology.ToDisplay()</div>
            }
            @if (vm.HasDocument(Item.DocumentId))
            {
                <div class="ipath_annotation_footer">
                    <span>@T["Comment on: "]</span><MudLink OnClick=@(() => vm.SelectDocument(Item.DocumentId.Value))>@DocumentCaption</MudLink>
                </div>
            }

            @if (!Item.Deleted)
            {
                <div class="ipath_annotation_reply_row">
                    @if (isReplying)
                    {
                        <div class="ipath_annotation_reply_context">
                            <MudIcon Icon="@Icons.Material.Filled.Reply" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="ml-1">
                                @T["Reply to"] <b>@Item.Owner.Username</b>
                            </MudText>
                        </div>
                        <MudTextField @bind-Value="replyText" Immediate="true"
                                      AutoGrow="true" Lines="3" Variant="Variant.Outlined"
                                      Placeholder="@T["Type your reply..."]" Class="mb-2" />
                        <MudStack Row Spacing="1">
                            <MudButton OnClick="SubmitReply" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">@T["Submit"]</MudButton>
                            <MudButton OnClick="CancelReply" Variant="Variant.Outlined" Size="Size.Small">@T["Cancel"]</MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudLink OnClick="Reply" Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.Reply" Size="Size.Small" /> @T["Reply"]</MudLink>
                    }
                </div>
            }
        </div>
    </div>

}
else
{
    <InlineAnnotationEdit Model="@editModel" EditDone="OnEditDone" />
}


@code {
    [Parameter]
    public AnnotationDto Item { get; set; }

    [Parameter]
    public EventCallback<AnnotationDto> OnDelete { get; set; }

    [Parameter]
    public EventCallback<AnnotationDto> OnEdit { get; set; }

    [Parameter]
    public AnnotationDto? ParentAnnotation { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "";

    private bool Hovering;
    private string Initials;

    private InlineAnnotationEdit edit;
    private bool isReplying;
    private string replyText = "";


    private string TextClass => "ipath_annotation_text" + (Item.Deleted ? " ipath_item_deleted" : "");


    protected override async Task OnParametersSetAsync()
    {
        if (Item != null)
        {
            Initials = (await uvm.GetProfileAsync(Item.OwnerId))?.Initials;
        }
    }

    string FullTitle()
    {
        if (Item is null) return "";
        var cType =  T[Item.Data.Type.ToString()];
        return string.Format(T["{0} by {1}"], cType, Item.Owner.Username);
    }

    string DocumentCaption => vm.SelectedRequest is not null && Item.DocumentId.HasValue ? vm.SelectedRequest.GetDocumentCaption(Item.DocumentId.Value) : "";

    protected override void OnChangedHandler()
    {
        // no need to redraw here
    }

    async Task Delete()
    {
        await OnDelete.InvokeAsync(Item);
    }

    async Task Reply()
    {
        isReplying = true;
        replyText = "";
    }

    async Task SubmitReply()
    {
        if (!string.IsNullOrWhiteSpace(replyText))
        {
            await vm.SubmitReply(Item.Id, replyText);
            isReplying = false;
            replyText = "";
        }
    }

    async Task CancelReply()
    {
        isReplying = false;
        replyText = "";
    }



    async Task Edit()
    {
        editModel = vm.GetAnnotationInput(Item.Id);
    }
    async Task CancelEdit()
    {
        editModel = null;
    }
    AnnotationEditModel? editModel;

    void OnEditDone()
    {
        editModel = null;
    }


    public bool CanDeleteAnnotation => vm.IsModerator;
    public bool CanEditAnnotation => vm.IsModerator || vm.IsSeesionUser(Item.OwnerId);

}
