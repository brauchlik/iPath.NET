@if (Items is not null)
{
    @foreach (var thread in Items.BuildThreads(Sort == SortDirection.Ascending))
    {
        @if (ShowAnnotations)
        {
            <AnnotationItemView Item="thread.Root" />
            @RenderChildren(thread.Children, 1)
        }
        else
        {
            <AnnotationSkeleton />
        }
    }
}

@inject ServiceRequestViewModel vm

@code {
    [Parameter]
    public ICollection<AnnotationDto>? Items { get; set; }

    [Parameter]
    public bool ShowAnnotations { get; set; }

    [Parameter]
    public SortDirection Sort { get; set; }

    RenderFragment RenderChildren(List<AnnotationThread> children, int depth) => builder =>
    {
        foreach (var child in children)
        {
            builder.OpenComponent<AnnotationItemView>(0);
            builder.AddAttribute(1, "Item", child.Root);
            builder.AddAttribute(2, "CssClass", $"ipath_annotation_indent depth-{Math.Min(depth, 5)}");
            builder.CloseComponent();
            builder.AddContent(3, RenderChildren(child.Children, depth + 1));
        }
    };
}
