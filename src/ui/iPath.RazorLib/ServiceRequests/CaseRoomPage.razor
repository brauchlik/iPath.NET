@page "/request/{id}/caseroom"

@using MudBlazor.Services
@using iPath.Application.Features.ServiceRequests
@using iPath.Blazor.Componenents.Layouts
@layout SlideshowLayout
@inherits ServiceRequestViewComponentBase
@inject ICaseRoomSyncService SyncService
@inject ICaseRoomSyncReceiver SyncReceiver
@inject IJSRuntime JS
@inject IOptions<iPathClientConfig> opts

<div style="height: 100%; width: 100%; background-color: black;">

    <div class="d-flex flex-column align-center justify-center py-1">
        <div class="d-flex justify-center gap-4 align-center">
            <div class="d-flex align-center gap-2">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowCircleLeft" Size="Size.Large" OnClick="GotoPrevious" />
                <MudIconButton Icon="@Icons.Material.Filled.ArrowCircleRight" Size="Size.Large" OnClick="GotoNext" />
                @if (!_isGuest)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Large" OnClick="ShareRoom" Title="Copy Share Link" />
                }
            </div>

            <div class="d-flex align-center gap-2">
                @{
                    var controller = Participants.FirstOrDefault(p => p.SessionId == _controllerSessionId);
                    if (_isController)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                            You are controlling
                        </MudChip>
                        <MudToggleIconButton Toggled="_pointerToolActive"
                                             ToggledChanged="OnPointerToggleChanged"
                                             Icon="@Icons.Material.Filled.FilterTiltShift"
                                             ToggledIcon="@Icons.Material.Filled.FilterTiltShift"
                                             Style="@(_pointerToolActive ? "" : "color: rgba(255,255,255,0.7);")"
                                             ToggledColor="Color.Error"
                                             Size="Size.Small"
                                             Title="Show Pointer Tool"
                                             ToggledTitle="Hide Pointer Tool" />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ReleaseControl" Color="Color.Secondary" Style="color: white; border-color: rgba(255,255,255,0.5);">
                            Release
                        </MudButton>
                    }
                    else if (controller is not null)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                            @controller.DisplayName controls
                        </MudChip>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TakeControl" Color="Color.Primary" Style="color: white; border-color: rgba(255,255,255,0.5);">
                            Take Control
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TakeControl" Color="Color.Primary" Style="color: white; border-color: rgba(255,255,255,0.5);">
                            Take Control
                        </MudButton>
                    }
                }
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                    @Participants.Count viewing
                </MudChip>
                <div title="@(SseConnected ? "SSE connected" : "SSE disconnected")"
                     style="display: flex; align-items: center; gap: 2px; font-size: 10px; font-family: monospace; color: rgba(255,255,255,0.5);">
                    <span style="color: @(SseConnected ? "lime" : "red")">@(SseConnected ? "\u25cf" : "\u25cb")</span>
                    sse
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.CloseFullscreen" Size="Size.Large" OnClick="@ExitRoom" />
            </div>
        </div>

        @if (vm.SelectedDocument?.File?.Filename is not null)
        {
            <div class="mt-1">
                <span style="color: rgba(255, 255, 255, 0.7); font-size: 14px; font-family: sans-serif; font-weight: 500;">
                    @vm.SelectedDocument.File.Filename
                </span>
            </div>
        }
    </div>

    <MudPaper Class="ipath_image slideshow" Style="background-color: black;" Elevation="0">
        <div id="osd-caseroom" style="width: 100%; height: calc(100vh - 120px); background-color: black;"></div>
        @if (CurrentViewport is not null)
        {
            <div style="position: absolute; bottom: 8px; left: 8px; color: rgba(255,255,255,0.5); font-size: 11px; font-family: monospace; pointer-events: none;">
                X: @CurrentViewport.X.ToString("F2")
                Y: @CurrentViewport.Y.ToString("F2")
                Z: @CurrentViewport.Zoom.ToString("F2")
            </div>
        }
    </MudPaper>
</div>

@code {
    [Parameter] public string id { get; set; }
    bool Wsi => opts.Value.WsiViewerActive;
}
