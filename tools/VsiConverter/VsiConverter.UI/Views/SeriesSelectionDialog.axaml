<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VsiConverter.UI.ViewModels"
        xmlns:models="clr-namespace:VsiConverter.UI.Models"
        x:Class="VsiConverter.UI.Views.SeriesSelectionDialog"
        x:DataType="vm:SeriesSelectionViewModel"
        Title="Select Image Series"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16" RowSpacing="8">
    <StackPanel>
      <TextBlock Text="Select which image series to convert"
                 FontWeight="Bold" FontSize="14" />
      <TextBlock Text="{Binding FileName}" Foreground="Gray" FontSize="12" />
      <TextBlock Text="{Binding StatusText}" Foreground="Gray" Margin="0,2,0,0" />
    </StackPanel>

    <ListBox Grid.Row="1"
             ItemsSource="{Binding AvailableSeries}"
             SelectedItem="{Binding SelectedSeries}"
             BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:AvailableSeries">
          <TextBlock Text="{Binding}" Margin="0,2" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <CheckBox Grid.Row="2"
              Content="Use same series for all files in this session"
              IsChecked="{Binding UseForAll}"
              Margin="0,4" />

    <StackPanel Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="BtnSkip" Content="Skip - use best" />
      <Button x:Name="BtnOk" Content="OK" />
    </StackPanel>
  </Grid>
</Window>
